<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LivingTech</title>
    <!-- Linking to External CSS (You can modify the styles later) -->
    <link rel="stylesheet" href="style.css">

    <!-- Optional: Add a favicon for your website -->
    <link rel="icon" href="favicon.ico" type="image/x-icon">
</head>

<body>
    <!-- Header Section -->
    <header>
        <nav>
            <ul>
                <li><a href="#home">Home</a></li>
                <li><a href="#about">About</a></li>
                <li><a href="#services">Services</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
        </nav>
    </header>

    <!-- Home Section -->
    <section id="home">
        <div class="container">
            <h1>Welcome to LivingTech!</h1>
            <p>Your platform to boost your social media presence through exchange services.</p>
            <a href="#services" class="cta-button">Learn More</a>
        </div>
    </section>

    <!-- About Section -->
    <section id="about">
        <div class="container">
            <h2>About Us</h2>
            <p>At LivingTech, we connect users to grow their social media presence with ease. Our platform offers a variety of tools and services to help you gain more followers, likes, and engagement.</p>
        </div>
    </section>

    <!-- Services Section -->
    <section id="services">
        <div class="container">
            <h2>Our Services</h2>
            <ul>
                <li>Follower Exchange</li>
                <li>Like and Comment Boost</li>
                <li>Social Media Analytics</li>
                <li>Referral Programs</li>
            </ul>
        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact">
        <div class="container">
            <h2>Contact Us</h2>
            <p>Have any questions? Reach out to us and we'll get back to you as soon as possible!</p>
            <a href="mailto:info@livingtech.com">Email Us</a>
        </div>
    </section>

    <!-- Footer Section -->
    <footer>
        <div class="container">
            <p>&copy; 2025 LivingTech. All rights reserved.</p>
        </div>
    </footer>

</body>

</html>

<link rel="stylesheet" href="style.css">
/* Reset some default styles */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f4f4f4;
    color: #333;
    line-height: 1.6;
}

/* Header */
header {
    background-color: #333;
    color: #fff;
    padding: 15px 0;
    text-align: center;
}

header nav ul {
    list-style: none;
}

header nav ul li {
    display: inline;
    margin: 0 15px;
}

header nav ul li a {
    color: white;
    text-decoration: none;
    font-weight: bold;
}

/* Home Section */
#home {
    background-color: #0066cc;
    color: white;
    text-align: center;
    padding: 80px 0;
}

#home h1 {
    font-size: 3em;
    margin-bottom: 20px;
}

.cta-button {
    background-color: #ff9900;
    color: white;
    padding: 10px 20px;
    text-decoration: none;
    font-size: 1.2em;
    border-radius: 5px;
    margin-top: 20px;
}

.cta-button:hover {
    background-color: #ff6600;
}

/* Section Styling */
section {
    padding: 40px 20px;
    text-align: center;
}

h2 {
    font-size: 2.5em;
    margin-bottom: 20px;
}

ul {
    list-style: none;
    padding: 0;
    font-size: 1.2em;
}

ul li {
    margin-bottom: 10px;
}

/* Footer */
footer {
    background-color: #333;
    color: white;
    padding: 15px;
    text-align: center;
}

footer p {
    font-size: 1em;
}
